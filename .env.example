# Base64 encoded values for Kubernetes secrets
# Generate with: echo -n "your_value" | base64
MARIADB_ROOT_PASSWORD_B64=
MARIADB_DATABASE_B64=cXVvdGVodWI=
MARIADB_USER_B64=
MARIADB_PASSWORD_B64=

# Container Images
QUOTE_API_IMAGE=ghcr.io/USERNAME/quote-api:latest
NGINX_WEB_IMAGE=ghcr.io/USERNAME/nginx-web:latest

# Helm Ingress-NGINX values
HETZNER_LOCATION=nbg1
LB_NAME=quotehub-ingress-lb
USE_PRIVATE_IP=true
USE_PROXYPROTOCOL=true
DOMAIN=example.com
HTTP_REDIRECT_HTTPS=false
# Kubernetes manifests
ACME_EMAIL=your-email@example.com
DOMAIN=example.com
